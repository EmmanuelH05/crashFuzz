{
  "name": "crashfuzz",
  "module": "core/src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "cf": "bun run core/src/index.ts",
    "test": "bun test",
    "test:vm": "bun run core/tools/tdd-report.ts",
    "test:controls": "bun test core/tests/controls",
    "typecheck": "bunx tsc --noEmit",
    "shim": "make -C shim",
    "vm:up": "limactl start --name=crashfuzz vm/lima.yaml",
    "vm:sh": "limactl shell crashfuzz",
    "vm:down": "limactl stop crashfuzz",
    "measure": "bun run core/tools/state-explosion.ts",
    "plots": "python3 plots/scripts/state_explosion.py"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
