node_modules/
*.log

# Build output
shim/build/
shim/*.so
# Each target builds into its own build/ dir (targets/<name>/build/), so the
# rule has to descend. A bare `targets/build/` matched nothing and let three
# aarch64 ELF binaries get committed.
targets/**/build/

# Materialized crash images and captured traces. Large, regenerable, and
# machine-specific. Test fixtures under core/tests/ are committed.
artifacts/**/*.img
artifacts/**/*.img.*
artifacts/**/images/
artifacts/**/traces/
*.loop
!core/tests/**/fixtures/**

# plots/out/ is committed: figures are versioned alongside the scripts that
# generate them.

.DS_Store

# tdd-guard test result bridge output (regenerated each run)
.claude/tdd-guard/

# Agent worktrees are full self-copies of this repo. Never commit them; they
# also inflate any recursive count run over the tree (once reported 1730 tests
# instead of 77).
.claude/worktrees/

# Cargo build output for Phase 0 target workloads
targets/**/target/
Cargo.lock
